# Copy to .env (gitignored) in this folder — speedtest_report.py reads it via
# load_dotenv() based on the current working directory.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# github-backup.sh and paymo-backup.sh read GITHUB_TOKEN / PAYMO_TOKEN from
# ~/.secrets.env (a fixed path, not project-relative) — inside the Dev
# Container that's /home/vscode/.secrets.env. Create it manually there with:
#   GITHUB_TOKEN=...
#   PAYMO_TOKEN=...
# Not something this setup can populate for you.
